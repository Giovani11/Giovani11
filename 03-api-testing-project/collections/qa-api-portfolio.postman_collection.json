{
  "info": {
    "_postman_id": "8f883652-3df6-4b2a-b733-1478229b0a1a",
    "name": "QA Portfolio API Testing Suite (Restful-Booker)",
    "description": "Comprehensive automated REST API test collection covering Authentication, Full CRUD operations, Contract/Schema Validation, and Negative Security Scenarios using Chai BDD assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Create Auth Token (Positive)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains valid auth token string', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.expect(jsonData.token).to.be.a('string').and.have.lengthOf.at.least(10);",
                  "    pm.environment.set('authToken', jsonData.token);",
                  "});",
                  "",
                  "pm.test('Response time is under threshold', function () {",
                  "    const maxTime = parseInt(pm.environment.get('expectedMaxResponseTimeMs') || '2000', 10);",
                  "    pm.expect(pm.response.responseTime).to.be.below(maxTime);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{adminUsername}}\",\n    \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": ["{{baseUrl}}"],
              "path": ["auth"]
            }
          },
          "response": []
        },
        {
          "name": "Create Auth Token - Invalid Credentials (Negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK with bad credentials reason', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('reason', 'Bad credentials');",
                  "    pm.expect(jsonData).to.not.have.property('token');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"invalid_user\",\n    \"password\": \"wrong_pass_999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": ["{{baseUrl}}"],
              "path": ["auth"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Booking CRUD Lifecycle",
      "item": [
        {
          "name": "Create Booking (POST)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Set dynamic booking values if not loaded from external test-data file",
                  "if (!pm.variables.get('firstname')) {",
                  "    pm.variables.set('firstname', 'Gio_' + Math.floor(Math.random() * 1000));",
                  "    pm.variables.set('lastname', 'QA_' + Math.floor(Math.random() * 1000));",
                  "    pm.variables.set('totalprice', 250);",
                  "    pm.variables.set('depositpaid', true);",
                  "    pm.variables.set('checkin', '2026-10-01');",
                  "    pm.variables.set('checkout', '2026-10-08');",
                  "    pm.variables.set('additionalneeds', 'High-speed Fiber WiFi');",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has bookingid and saves to environment', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('bookingid');",
                  "    pm.expect(jsonData.bookingid).to.be.a('number');",
                  "    pm.environment.set('bookingId', jsonData.bookingid);",
                  "});",
                  "",
                  "pm.test('Booking payload details match request data', function () {",
                  "    const booking = pm.response.json().booking;",
                  "    pm.expect(booking.firstname).to.eql(pm.variables.get('firstname'));",
                  "    pm.expect(booking.lastname).to.eql(pm.variables.get('lastname'));",
                  "    pm.expect(booking.totalprice).to.eql(parseInt(pm.variables.get('totalprice'), 10));",
                  "    pm.expect(booking.depositpaid).to.eql(Boolean(pm.variables.get('depositpaid')));",
                  "    pm.expect(booking.bookingdates.checkin).to.eql(pm.variables.get('checkin'));",
                  "    pm.expect(booking.bookingdates.checkout).to.eql(pm.variables.get('checkout'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"{{firstname}}\",\n    \"lastname\": \"{{lastname}}\",\n    \"totalprice\": {{totalprice}},\n    \"depositpaid\": {{depositpaid}},\n    \"bookingdates\": {\n        \"checkin\": \"{{checkin}}\",\n        \"checkout\": \"{{checkout}}\"\n    },\n    \"additionalneeds\": \"{{additionalneeds}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": ["{{baseUrl}}"],
              "path": ["booking"]
            }
          },
          "response": []
        },
        {
          "name": "Get Booking by ID (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Content-Type header is JSON', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('Booking contract schema validation', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.all.keys('firstname', 'lastname', 'totalprice', 'depositpaid', 'bookingdates', 'additionalneeds');",
                  "    pm.expect(jsonData.bookingdates).to.have.all.keys('checkin', 'checkout');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "{{bookingId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Full Update Booking (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Booking totalprice updated to 450', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.totalprice).to.eql(450);",
                  "    pm.expect(jsonData.additionalneeds).to.eql('Airport Shuttle & Breakfast');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"{{firstname}}\",\n    \"lastname\": \"{{lastname}}\",\n    \"totalprice\": 450,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"{{checkin}}\",\n        \"checkout\": \"{{checkout}}\"\n    },\n    \"additionalneeds\": \"Airport Shuttle & Breakfast\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "{{bookingId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Partial Update Booking (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Partial field updated successfully', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.additionalneeds).to.eql('VIP Suite Upgrade');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"additionalneeds\": \"VIP Suite Upgrade\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "{{bookingId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Booking (DELETE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created (successful delete in Restful-Booker)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "{{bookingId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Verify Deleted Booking Returns 404 (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Deleted resource returns 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "{{bookingId}}"]
            }
          },
          "response": []
        }
      ]
    },
